{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "utmmsc-site",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // Same bucket as the API. The site only reads downloads/android/UTMMSC.apk for /download/android.
  // 与 API 共用同一个桶。官网只读取 downloads/android/UTMMSC.apk，用于 /download/android。
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "utmmsc-files" }
  ],

  // Apex is the public site. The member app stays on /UTMMSC/ and is not this Worker's root.
  // 根域名是官网。成员网络留在 /UTMMSC/，不是这个 Worker 的根路径。
  "routes": [
    { "pattern": "utmmsc.com", "custom_domain": true },
    { "pattern": "www.utmmsc.com", "custom_domain": true }
  ]
}
