<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The chat long-press gives a short vibration through navigator.vibrate. CAMERA is deliberately absent:
         without it the photo button hands off to the camera app, which needs no permission from this app. -->
    <!-- 聊天长按通过 navigator.vibrate 轻振一下。刻意不声明 CAMERA：不声明时拍摄按钮交给相机应用处理，本应用无需相机权限。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ asks the member before the app may show notifications; the web requests it from settings. -->
    <!-- Android 13 及以上需经成员同意才能显示通知；由网页在设置中请求。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets Capacitor see the camera app on Android 11+; otherwise the photo button falls back to the gallery. -->
    <!-- 让 Capacitor 在 Android 11 及以上能找到相机应用，否则拍摄按钮会退回到相册。 -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Backups stay off so the login token cannot be copied off the phone. -->
    <!-- 关闭备份，登录令牌无法被复制出手机。 -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Firebase shows pushes in the tray while the app is in the background; these set their look and the
             channel used when a push names none. The API names "messages" or "events" and the same icon itself. -->
        <!-- 应用在后台时由 Firebase 把推送显示在通知栏；以下设置通知的样式，以及推送未指定渠道时使用的渠道。
             API 自身会指定 "messages" 或 "events" 渠道和同一个图标。 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/utmmsc_purple" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
        <!-- No push token is created until the member turns notifications on: register() switches this on and
             unregister() off again, and Firebase remembers the choice across launches. -->
        <!-- 成员开启通知之前不生成推送令牌：register() 将其打开，unregister() 再关上，Firebase 会在多次启动间记住该选择。 -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>
</manifest>
