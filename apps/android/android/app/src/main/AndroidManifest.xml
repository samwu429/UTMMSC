<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The chat long-press gives a short vibration through navigator.vibrate. CAMERA is deliberately absent:
         without it the photo button hands off to the camera app, which needs no permission from this app. -->
    <!-- 聊天长按通过 navigator.vibrate 轻振一下。刻意不声明 CAMERA：不声明时拍摄按钮交给相机应用处理，本应用无需相机权限。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets Capacitor see the camera app on Android 11+; otherwise the photo button falls back to the gallery. -->
    <!-- 让 Capacitor 在 Android 11 及以上能找到相机应用，否则拍摄按钮会退回到相册。 -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Backups stay off so the login token cannot be copied off the phone. -->
    <!-- 关闭备份，登录令牌无法被复制出手机。 -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
