{
  "name": "@utmmsc/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply utmmsc --local",
    "migrate:remote": "wrangler d1 migrations apply utmmsc --remote",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:budget": "vitest run --config vitest.budget.config.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@utmmsc/shared": "*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  }
}
