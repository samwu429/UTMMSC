# Dependencies
node_modules/

# Build output
dist/
apps/site/public/
.wrangler/
*.tsbuildinfo

# Local secrets and environment. Real values live here or in Cloudflare secrets, never in git.
# 本地密钥与环境变量。真实值只存在于此处或 Cloudflare secrets，不进入 git。
.env
.env.*
.dev.vars
.dev.vars.*
.vapid-private.json

# Android release signing key and its passwords. Back them up outside git; see apps/android/README.md.
# 安卓发布签名密钥及其密码。请在 git 之外备份，见 apps/android/README.md。
apps/android/keystore/
apps/android/keystore.properties
apps/android/**/*.jks
apps/android/**/*.keystore

# Firebase config for Android push. Not a secret, but kept out of git until the owner decides; see apps/android/README.md.
# 安卓推送的 Firebase 配置。它不是密钥，但在负责人决定之前不进入 git；见 apps/android/README.md。
apps/android/android/app/google-services.json

# Local emulator screenshots. Gradle output is ignored by apps/android/android/.gitignore.
# 本地模拟器截图。Gradle 构建产物由 apps/android/android/.gitignore 忽略。
apps/android/build-check/

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
